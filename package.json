{
  "name": "node-core-interview-lab",
  "version": "2.0.0",
  "description": "A no-Express Node.js core interview lab with adaptive levels, rubric scoring, persistent progress, streams, events, and non-repeating questions.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "reset": "node scripts/reset-data.js",
    "generate:questions": "node scripts/generate-questions.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nodejs",
    "http",
    "event-loop",
    "filesystem",
    "streams",
    "events",
    "commonjs",
    "npm",
    "interview",
    "assessment"
  ],
  "license": "MIT"
}
